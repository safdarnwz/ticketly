# --- Server ---
PORT=3000
CORS_ORIGIN=http://localhost:5173
LENDER_NAME="Your NBFC Pvt Ltd (RBI CoR pending)"
GRIEVANCE_OFFICER="Grievance Officer, grievance@example.com, +91-00000-00000"

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://lending:lending@localhost:5432/lending

# --- Secrets (use a secrets manager in production) ---
JWT_SECRET=change-me-to-a-long-random-string
PII_ENCRYPTION_KEY=   # 32 bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_HASH_PEPPER=change-me-too
PAYOUT_WEBHOOK_SECRET=change-me-webhook

# --- Integrations ---
# sandbox = built-in simulators (no real KYC, bureau, e-sign or money movement)
# live    = real provider adapters (must be implemented per signed vendor contract)
INTEGRATIONS_MODE=sandbox
SANDBOX_LATENCY_MS=300

# --- Instant journey ---
JOURNEY_TARGET_SECONDS=300
OFFER_VALIDITY_MINUTES=15

# --- Digio (eKYC via DigiLocker + Aadhaar eSign) ---
# sandbox = built-in simulator; digio = real Digio API (sandbox or production per DIGIO_ENV)
EKYC_PROVIDER=sandbox
ESIGN_PROVIDER=sandbox
DIGIO_ENV=sandbox
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
# Workflow template created in Digio DigiStudio (DigiLocker Aadhaar + PAN)
DIGIO_KYC_TEMPLATE=DIGILOCKER_AADHAAR_PAN
# Same secret as configured on the Digio webhook (X-Digio-Checksum = HMAC-SHA256 of raw body)
DIGIO_WEBHOOK_SECRET=

# --- Repayment (no eNACH: customer pays by UPI / net banking / debit card) ---
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook
PUBLIC_WEB_URL=http://localhost:5173
