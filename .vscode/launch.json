{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Shelfwise: API + local UI",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "args": ["--ui"],
      "runtimeArgs": ["--watch"],
      "console": "integratedTerminal",
      "serverReadyAction": { "pattern": "UI also served here: (https?://\\S+)", "uriFormat": "%s", "action": "openExternally" }
    },
    {
      "name": "Shelfwise: API only (for the GitHub Pages site)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "runtimeArgs": ["--watch"],
      "console": "integratedTerminal"
    },
    {
      "name": "Shelfwise: demo data",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "args": ["--demo", "--ui"],
      "runtimeArgs": ["--watch"],
      "console": "integratedTerminal",
      "serverReadyAction": { "pattern": "UI also served here: (https?://\\S+)", "uriFormat": "%s", "action": "openExternally" }
    }
  ]
}
