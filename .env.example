# Copy to .env and adjust. .env is git-ignored - never commit tokens or passwords.

# --- Sign-in ---
# true  = every viewer signs in with their own SalesDiary account (company key -> username/password)
# false = no login screen; everyone sees data from SD_TOKEN below (or demo data if it's empty)
REQUIRE_LOGIN=true
# Pre-fills the company key on the login screen
SD_COMPANY_KEY=glenmark
# Signed-in sessions expire after this many idle hours
SESSION_HOURS=12

# --- SalesDiary endpoints ---
SD_LOGIN_BASE=https://sdlogin.salesdiary.in:2001
SD_API_BASE=https://inx11.salesdiary.in:4071
SD_REPORT_PATH=/api/pwa_reports/getStockAvailablityReport
SD_PWA_VERSION=293
# Rows per API call ("offset" in the request) and how the next page is requested:
#   id = offsetID is the last row id, offset = offsetID is a row count, none = single call
SD_PAGE_SIZE=5000
SD_PAGINATION=id

# Only used when REQUIRE_LOGIN=false: a shared token for all viewers (expires every ~16 h)
SD_TOKEN=

# auto = normal, mock = demo data only (no SalesDiary calls), live = never fall back to demo
DATA_SOURCE=auto

# --- Server ---
PORT=8080
# How long one upstream response is reused (ms). Browsers polling every 5 s share it.
CACHE_TTL_MS=4000
# Allow "sign in with a token" / "replace token" in the UI
ALLOW_TOKEN_UPDATE=true

# --- Extra gate for public URLs (optional) ---
# Adds a browser password prompt in front of everything, including the login screen.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
