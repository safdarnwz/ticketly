# =============================================================================
#  Ticketly — environment configuration (backend API + worker)
#
#  Local:  `npm run setup` copies this file to .env and fills JWT_SECRET and
#          ENCRYPTION_KEY with fresh random values. Edit the DB/Redis lines if
#          yours differ.
#  Server: copy to /opt/ticketly/shared/.env (docs/DEPLOYMENT.md).
#  Never commit a real .env.
#
#  Every setting the API reads is listed here with its default
#  (libs/config/src/env.schema.ts is the source of truth). A line left out of
#  .env falls back to that default. Booleans: true/false (also 1/0, yes/no).
#  Lists: comma-separated.
# =============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | test | staging | production
NODE_ENV=development
APP_NAME=ticketly
APP_VERSION=0.0.0
# Names this instance in logs and metrics (defaults to the hostname).
# INSTANCE_ID=

# ── HTTP server ──────────────────────────────────────────────────────────────
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
# Public base URL of the API — webhook callbacks and absolute links.
PUBLIC_BASE_URL=http://localhost:3000
# Where customer links in SMS / email point (the storefront).
PUBLIC_WEB_URL=http://localhost:5173
API_PREFIX=api
# 8 MB: fits a 5 MB fleet document uploaded as base64.
HTTP_BODY_LIMIT_BYTES=8388608
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=72000
# Must exceed the load balancer's idle timeout.
HTTP_HEADERS_TIMEOUT_MS=75000
HTTP_TRUST_PROXY=true
# Comma-separated origins, or * in development.
CORS_ORIGINS=*
CORS_CREDENTIALS=true
# Shed load when the event loop lags; 0 = off for the memory limits.
OVERLOAD_MAX_EVENT_LOOP_DELAY_MS=1000
OVERLOAD_MAX_HEAP_USED_BYTES=0
OVERLOAD_MAX_RSS_BYTES=0

# ── PostgreSQL 16 (primary) ──────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ticketly
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SCHEMA=public
# Pool: DB_POOL_MAX x instances must stay under Postgres max_connections.
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_MAX_USES_PER_CONNECTION=7500
# Server-side guards: a query over these is killed, not queued.
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=3000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
# Log queries slower than this (parameters redacted).
DB_SLOW_QUERY_MS=150
DB_LOG_QUERIES=false
DB_APPLICATION_NAME=ticketly-api

# ── PostgreSQL read replicas (optional) ──────────────────────────────────────
# Comma-separated host:port list. Empty = every read goes to the primary.
DB_REPLICA_HOSTS=
DB_REPLICA_POOL_MAX=20
DB_REPLICA_MAX_LAG_MS=2000
DB_REPLICA_HEALTHCHECK_INTERVAL_MS=5000

# ── Cache and Redis 7 (cache, locks, rate limits) ────────────────────────────
CACHE_L1_ENABLED=true
CACHE_L1_MAX_ITEMS=50000
CACHE_L1_TTL_MS=5000
# L2 = Redis shared across instances; without it the API uses L1 only.
CACHE_L2_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=gds
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_MAX_RETRIES_PER_REQUEST=2

# ── Secrets and security (npm run setup generates JWT_SECRET and ENCRYPTION_KEY)
# At least 32 characters. Required in production (the built-in default is public).
JWT_SECRET=
# The previous secret while rotating, so issued tokens keep working.
# JWT_SECRET_PREVIOUS=
# 15 minutes / 30 days.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=ticketly
JWT_AUDIENCE=ticketly-clients
# base64 of 32 random bytes — make one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (or `openssl rand -base64 32`). May stay empty in local development. Encrypts phone numbers
# and emails. Required in production. Do NOT change it once data exists —
# rotate with ENCRYPTION_KEY_ID / ENCRYPTION_PREVIOUS_KEYS (docs/RUNBOOK.md).
ENCRYPTION_KEY=
# v1, v2 … written in front of every encrypted value.
ENCRYPTION_KEY_ID=v1
# Retired keys, only for reading old values: v1:<base64>,v2:<base64>
ENCRYPTION_PREVIOUS_KEYS=
# Key for searchable phone/email hashes. Must never change; empty = derived from the v1 key.
BLIND_INDEX_KEY=
# Argon2 password hashing cost.
PASSWORD_HASH_MEMORY_KIB=19456
PASSWORD_HASH_ITERATIONS=2
PASSWORD_HASH_PARALLELISM=1

# ── Super admin (created / repaired on every seed and API start) ─────────────
# Change the password before going live.
SUPER_ADMIN_EMAIL=admin@ticketly.local
SUPER_ADMIN_PASSWORD=Admin@12345
SUPER_ADMIN_NAME=Ticketly Super Admin

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_IP=600
RATE_LIMIT_MAX_PER_TENANT=6000
RATE_LIMIT_SEARCH_PER_MINUTE=120
RATE_LIMIT_BOOKING_PER_MINUTE=30

# ── Idempotency (double clicks and retries) ──────────────────────────────────
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_TTL_SECONDS=86400

# ── Logging, metrics, tracing ────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
LOG_PRETTY=true
# Extra log paths to redact (comma-separated); empty = the built-in list
# (authorization, cookie, x-api-key, password, otp, cardNumber, cvv).
LOG_REDACT_PATHS=
METRICS_ENABLED=true
METRICS_PATH=/metrics
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=ticketly-api
# 0.0 – 1.0
OTEL_TRACE_SAMPLE_RATIO=0.05

# ── API docs (Swagger) ───────────────────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# ── Bus operations defaults ──────────────────────────────────────────────────
DEFAULT_TIMEZONE=Asia/Kolkata
# INR | USD | AED | LKR | NPR | BDT
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN
# Days of trips created ahead (1–365).
INVENTORY_HORIZON_DAYS=120
# How long a seat stays held while paying (30–3600 seconds).
SEAT_HOLD_TTL_SECONDS=600
# Sales close this many minutes before departure.
BOOKING_CUTOFF_MINUTES=30

# ── Background worker (run `npm run dev:worker` in a second terminal) ────────
WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=200
OUTBOX_MAX_ATTEMPTS=12
JOB_CONCURRENCY=8

# ── Graceful shutdown ────────────────────────────────────────────────────────
SHUTDOWN_DELAY_MS=5000
SHUTDOWN_TIMEOUT_MS=20000

# ── Payments: built-in test gateway (no real money) ─────────────────────────
# Must be false in production.
PAYMENT_TEST_MODE=true
PAYMENT_TEST_UPI_SUCCESS_VPA=success@ticketly
PAYMENT_TEST_UPI_FAILURE_VPA=failure@ticketly
PAYMENT_TEST_CARD_SUCCESS=4111111111111111
PAYMENT_TEST_CARD_FAILURE=4000000000000002
PAYMENT_TEST_CARD_CVV=123
PAYMENT_TEST_CARD_EXPIRY=12/30
PAYMENT_TEST_NETBANKING_USER=ticketly
PAYMENT_TEST_NETBANKING_PASSWORD=test1234
PAYMENT_TEST_NETBANKING_BANKS=HDFC,ICICI,SBI,AXIS,KOTAK

# ── Payments: Razorpay (optional; empty = the test gateway above) ────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when registering the webhook in the Razorpay dashboard (not the key secret).
RAZORPAY_WEBHOOK_SECRET=

# ── SMS and WhatsApp: MSG91 (optional; empty key = messages only logged) ─────
MSG91_AUTH_KEY=
# 6-character DLT-approved sender id.
MSG91_SENDER_ID=TCKTLY
# 4 = transactional.
MSG91_ROUTE=4
MSG91_DLT_TEMPLATE_ID=
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_WHATSAPP_NAMESPACE=

# ── Email via Gmail SMTP (optional; without it emails are only logged) ──────
# An SMTP integration saved by the super admin takes priority over these.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=

# ── Operator KYC: Digio / DigiLocker (optional) ──────────────────────────────
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
# sandbox | production
DIGIO_ENV=sandbox

# ── File storage: database (default) | r2 | s3 | azure ──────────────────────
STORAGE_PROVIDER=database
# R2/S3 bucket, or Azure container.
STORAGE_BUCKET=
# auto for R2; e.g. ap-south-1 for S3.
STORAGE_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com   S3: https://s3.<region>.amazonaws.com
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_AZURE_ACCOUNT=
STORAGE_AZURE_ACCOUNT_KEY=
# e.g. prod → prod/orange-travels/...
STORAGE_KEY_PREFIX=
# Public CDN origin for logos and bus photos, e.g. https://cdn.ticketly.com
STORAGE_PUBLIC_BASE_URL=
# Private documents: short-lived signed links (30–3600 seconds).
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_TIMEOUT_MS=15000
