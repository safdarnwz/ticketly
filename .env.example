# Copy to .env and adjust. .env is git-ignored - never commit tokens or passwords.

# --- Token ---
# true  = each browser pastes its own SalesDiary token in the box at the top of the page
# false = no box; everyone sees data from SD_TOKEN below (or demo data if it's empty)
REQUIRE_TOKEN=true
# A pasted token's session ends after this many idle hours (or when the token expires)
SESSION_HOURS=12

# --- SalesDiary endpoints ---
SD_API_BASE=https://inx11.salesdiary.in:4071
SD_REPORT_PATH=/api/pwa_reports/getStockAvailablityReport
# Rows per API call ("offset" in the request) and how the next page is requested:
#   id = offsetID is the last row id, offset = offsetID is a row count, none = single call
SD_PAGE_SIZE=5000
SD_PAGINATION=id

# Only used when REQUIRE_TOKEN=false: a shared token for all viewers (expires every ~16 h)
SD_TOKEN=

# auto = normal, mock = demo data only (no SalesDiary calls), live = never fall back to demo
DATA_SOURCE=auto

# --- Website (GitHub Pages) <-> this server ---
# Browser origins allowed to call this server. localhost is always allowed.
CORS_ORIGINS=https://safdarnwz.github.io
# Where the website lives (the server's own page links here)
DASHBOARD_URL=https://safdarnwz.github.io/ticketly/
# true = also serve the UI from this server (same as `npm run dev` / --ui)
SERVE_UI=false

# --- Server ---
PORT=8080
# How long one upstream response is reused (ms). Browsers polling every 5 s share it.
CACHE_TTL_MS=4000
# Allow pasting a token in the box at the top of the page
ALLOW_TOKEN_UPDATE=true

# --- Extra gate for public URLs (optional) ---
# Adds a browser password prompt in front of everything.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
