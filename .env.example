# =============================================================================
#  Ticketly — environment configuration
#
#  Local:  `npm run setup` copies this file to .env and fills JWT_SECRET and
#          ENCRYPTION_KEY with fresh random values. Edit the DB/Redis lines if
#          yours differ. Every other setting has a working default
#          (libs/config/src/env.schema.ts lists them all).
#  Server: copy to /opt/ticketly/shared/.env (docs/DEPLOYMENT.md).
#  Never commit a real .env.
# =============================================================================

NODE_ENV=development
HTTP_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Where customer links in SMS / email point (the storefront).
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=*

# ── PostgreSQL 16 ────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ticketly
DB_USER=postgres
DB_PASSWORD=postgres

# ── Redis 7 (cache, locks, rate limits) ─────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Secrets (npm run setup generates both) ──────────────────────────────────
# At least 32 characters.
JWT_SECRET=
# base64 of 32 random bytes: `openssl rand -base64 32`. Encrypts phone numbers
# and emails. Do NOT change it once data exists — see docs/RUNBOOK.md (key rotation).
ENCRYPTION_KEY=

# ── Super admin (created / repaired on every seed and API start) ────────────
SUPER_ADMIN_EMAIL=admin@ticketly.local
SUPER_ADMIN_PASSWORD=Admin@12345
SUPER_ADMIN_NAME=Ticketly Super Admin

# ── Background worker (run `npm run dev:worker` in a second terminal) ────────
WORKER_ENABLED=true

# ── Logging / API docs ───────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true
SWAGGER_ENABLED=true

# ── Payments: built-in test gateway (no real money) ─────────────────────────
PAYMENT_TEST_MODE=true
# Razorpay (optional; leave empty to use the test gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email via Gmail SMTP (optional; without it emails are only logged) ──────
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=

# ── File storage: database (default) | r2 | s3 | azure ──────────────────────
STORAGE_PROVIDER=database
