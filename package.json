{
  "name": "ticketly",
  "version": "1.0.0",
  "private": true,
  "description": "Ticketly — enterprise multi-tenant Bus GDS / reservation platform (NestJS + TypeScript + PostgreSQL)",
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.2",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch --enable-source-maps -r @swc-node/register -r tsconfig-paths/register apps/api/src/main.ts",
    "dev:worker": "node --watch --enable-source-maps -r @swc-node/register -r tsconfig-paths/register apps/worker/src/main.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/apps/api/src/main.js",
    "start:worker": "node dist/apps/worker/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "setup": "tsx scripts/setup-local.ts",
    "demo:onboarding": "node scripts/demo-onboarding.mjs",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:migrate:down": "tsx scripts/migrate.ts down",
    "db:migrate:status": "tsx scripts/migrate.ts status",
    "db:new": "tsx scripts/new-migration.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:geography": "tsx scripts/run-sql.ts db/seeds/geography.seed.sql",
    "db:seed:demo": "tsx scripts/run-sql.ts db/seeds/demo-operator.seed.sql && tsx scripts/seed-demo-admin.ts",
    "db:seed:multi-operator": "tsx scripts/run-sql.ts db/seeds/multi-operator.seed.sql && tsx scripts/seed-operator-admins.ts",
    "generate:bookings": "node -r @swc-node/register -r tsconfig-paths/register scripts/generate-bookings.ts",
    "db:refresh-reports": "tsx scripts/refresh-reports.ts",
    "storage:migrate": "tsx scripts/storage-migrate.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:seed:full": "npm run db:reset && npm run db:migrate && npm run db:seed && npm run db:seed:geography && npm run db:seed:demo && npm run db:seed:multi-operator && npm run generate:bookings && npm run db:refresh-reports",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "start:dev": "node --watch --enable-source-maps -r @swc-node/register -r tsconfig-paths/register apps/api/src/main.ts",
    "start:dev:worker": "node --watch --enable-source-maps -r @swc-node/register -r tsconfig-paths/register apps/worker/src/main.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^10.1.3",
    "@fastify/under-pressure": "^9.0.3",
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-fastify": "^11.0.12",
    "@nestjs/swagger": "^11.0.6",
    "@nestjs/terminus": "^11.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.1",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.57.1",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "lru-cache": "^11.0.2",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.15.0",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuidv7": "^1.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.7.26",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^6.4.15",
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.11.11",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vitest/coverage-v8": "^3.0.7",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-import": "^2.31.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.2",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1",
    "unplugin-swc": "^1.6.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.7"
  }
}
