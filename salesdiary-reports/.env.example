# Copy to .env and adjust. The token is NOT configured here – it is pasted in the web page for each report.
PORT=8080
SD_API_BASE=https://inx11.salesdiary.in:4071
SD_TERTIARY_PATH=/api/pwa_reports/tertiarySalesReport
SD_TIMEOUT_SECONDS=120
SD_MAX_RETRIES=4
# "offset" in the API body is the time-zone offset in minutes (IST = 330), not a page number
SD_TZ_OFFSET=330
# auto = one call for the whole range, re-fetch day by day only if the row count looks capped
# single = always one call · daily = always one call per day
SD_FETCH_MODE=auto
MAX_RANGE_DAYS=92
KEEP_RAW_JSON=true
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=8

# Action Center thresholds
NO_SALE_DAYS=3          # promoter flagged when no sale for this many days
DROP_PCT=20             # promoter / outlet flagged when down this % vs LMTD
DROP_MIN_RS=5000        # ...and LMTD sale was at least this much (ignore tiny ones)
FOCUS_PENETRATION=0.4   # a SKU is "focus" when sold in this share of outlets of the channel
QTY_SPIKE_MIN=10        # a line is a quantity spike when qty >= this AND >= QTY_SPIKE_X x usual qty of the SKU
QTY_SPIKE_X=5
